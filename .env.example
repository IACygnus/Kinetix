# ============================================================
# JMeter Analyzer Pro v2.0 — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ========================================
# GENERAL
# ========================================
ENVIRONMENT=development
# APP_NAME=JMeter Analyzer Pro
# DEBUG=true

# ========================================
# BASE DE DATOS — PostgreSQL
# ========================================
POSTGRES_USER=jmeter_user
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=jmeter_analyzer_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ========================================
# SEGURIDAD — JWT
# ========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<your-jwt-secret-key>
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# ADMIN SEED — Password for the initial admin user
# ========================================
ADMIN_DEFAULT_PASSWORD=<your-admin-password>

# ========================================
# BACKEND — FastAPI
# ========================================
# BACKEND_PORT=8001
# BACKEND_HOST=0.0.0.0

# ========================================
# CORS — Comma-separated allowed origins
# In production set to your actual frontend URL(s)
# ========================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========================================
# FRONTEND — React (Vite)
# ========================================
VITE_API_BASE_URL=http://localhost:8001/api/v1

# ========================================
# GEMINI AI
# Get your key at: https://makersuite.google.com/app/apikey
# ========================================
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# ========================================
# FILE UPLOADS
# ========================================
# UPLOAD_DIR=/app/uploads
# MAX_UPLOAD_SIZE_MB=100

# ========================================
# FERNET ENCRYPTION — Used for monitoring token storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is auto-generated (not persistent between restarts)
# ========================================
FERNET_KEY=<your-fernet-key>

# ========================================
# INFLUXDB — Real-time Monitoring
# ========================================
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=<your-influxdb-password>
INFLUXDB_ORG=performance
INFLUXDB_BUCKET=jmeter
INFLUXDB_TOKEN=<your-influxdb-token>
INFLUXDB_PORT=8086

# ========================================
# GRAFANA — Dashboards
# ========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<your-grafana-password>
GRAFANA_PORT=3000
